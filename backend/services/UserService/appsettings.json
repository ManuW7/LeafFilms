{
  "ConnectionStrings": {
    "Default": "Host=${DB_HOST};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "Jwt": { "Secret": "${JWT_SECRET}" },
  "RabbitMQ": {
    "Host": "${RABBITMQ_HOST}",
    "User": "${RABBITMQ_USER}",
    "Pass": "${RABBITMQ_PASS}"
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}