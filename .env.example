# Copy this file to .env before local launch:
#   cp .env.example .env
#
# .env is intentionally ignored by git. These defaults match the local Docker
# volumes used by this demo project. Replace them for any shared environment.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# Must be at least 32 characters for HMAC signing.
JWT_SECRET=your-256-bit-secret-here-minimum-32-chars-CHANGE-IN-PROD

# Used by POST /api/users/admin/promote to grant the admin role.
ADMIN_SETUP_SECRET=change-me-admin-setup-secret
